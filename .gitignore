# Virtual environment
fyp_env/
.venv/

# Cloned external dependencies
sam2_repo/
cotracker_repo/

# Model checkpoints (large files, re-downloadable via README instructions)
checkpoints/
cotracker_checkpoints/
*.pt
*.pth

# Raw dataset (large video files, not owned/distributable)
dataset/
*.mp4
*.mov
*.avi
*.mkv
*.webm

# Generated/derived pipeline data (regenerated by running the scripts)
frames/
masks/
pose/
seed_points/
trajectories/

# Visual QC review folders (regenerated by the visualize_*.py scripts)
sanity_checks/
frame_review/
mask_review/
pose_review/
visualizations/
visualizations_cotracker/

# Logs
failures.txt
phase3_failures.txt

# Python cache/build artifacts
__pycache__/
*.pyc
*.pyo
*.egg-info/
build/
dist/

# OS junk files
.DS_Store
Thumbs.db

# Editor/IDE folders
.vscode/
.idea/